#!/bin/bash
# Commit-msg Hook: Checks length >= 10 chars & Conventional Commits prefix
msg=$(head -n 1 "$1")
if [ ${#msg} -lt 10 ]; then
  echo "[COMMIT-MSG ERROR] Commit rejected:"
  echo "Message is too short (${#msg} characters). Minimum required is 10 characters. Message was: '$msg'"
  exit 1
fi
if ! [[ "$msg" =~ ^(feat|fix|docs|refactor|chore): ]]; then
  echo "[COMMIT-MSG ERROR] Commit rejected:"
  echo "Commit message must start with one of: feat:, fix:, docs:, refactor:, chore:"
  exit 1
fi
exit 0
